# Normalise text to LF in the repo
* text=auto eol=lf

# Source
*.py    text diff=python
*.md    text diff=markdown
*.html  text diff=html

# Generated by cad/build_viewer.py (STL embedded as base64): keep out of diffs and language stats
out/*_viewer.html -diff linguist-generated

# CAD / fabrication files: never touch line endings, never diff or merge
*.step binary
*.stp  binary
*.stl  binary
*.3mf  binary

# Images and documents
*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
